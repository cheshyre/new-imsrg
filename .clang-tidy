# imsrg rewrite: clang-tidy configuration (clang-tidy 23; design/17-code-style.md section 4).
# readability-identifier-naming enforces the Google naming rules; tools/lint.sh runs it (not part
# of tools/ci.sh, which stays under 5 minutes). The bugprone/performance/modernize subsets are
# advisory and not enforced.
Checks: >-
  bugprone-*,performance-*,modernize-*,readability-identifier-naming,
  -modernize-use-trailing-return-type,-bugprone-easily-swappable-parameters,
  -modernize-avoid-c-arrays
WarningsAsErrors: ''
HeaderFilterRegex: '.*/(src|apps|tests|python|tools/bench)/.*'
ExcludeHeaderFilterRegex: '.*/(extern|tools/reference|tests/golden)/.*'
FormatStyle: file
CheckOptions:
  # Types, concepts and template parameters: CamelCase. STL protocol aliases keep their names.
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.ConceptCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  readability-identifier-naming.TypeAliasIgnoredRegexp: '^(value_type|size_type|difference_type|reference|const_reference|pointer|const_pointer|iterator|const_iterator|iterator_category|element_type|type)$'
  readability-identifier-naming.TemplateParameterCase: CamelCase
  # Functions and methods: CamelCase. Accessors (const, return a property or part of the object,
  # possibly selected by an index or key), mutators (set_*) and STL analogs keep snake_case
  # (Google style guide, "Function Names"); MethodIgnoredRegexp is that allowlist, collected
  # during the conversion (design/17 section 3). Static member functions are not accessors,
  # except ThreeBodyChannels::channel_index and the internal DeviceBufferAccess::view, which
  # share the names of accessors.
  readability-identifier-naming.FunctionCase: CamelCase
  readability-identifier-naming.FunctionIgnoredRegexp: '^(swap|begin|end|size|data|get)$'
  readability-identifier-naming.MethodCase: CamelCase
  readability-identifier-naming.MethodIgnoredRegexp: '^(set_[a-z0-9_]+|A_core|Z_core|active|aliases|allocated|any|at|at_end|back|basis|begin|bits|block_index|block_info|block_offsets|block_size|blocks|buffer|capacity|cbegin|cend|channel|channel_index|channel_ket_table|channel_kets|channel_of|channels|channels_by_size|classes|clear|col|cols|const_view|contains|core|count|cuts|data|device_block|device_data|device_view|dim|e|e2max|e_fermi|effective_e2max|emax|emplace_back|empty|empty_file|enabled|end|entries|erase|error|eta|fill|find|find_block|find_channel|find_ket|find_row|front|generator_options|get|get_if|get_isospin|get_normalized|get_pn|get_unnormalized|given|given_valid_double|given_valid_int|global_ket|hamiltonian|has|has_table|has_valence_space|has_value|hbar_omega|hermiticity|holes|host_block|host_is_device|host_span|host_view|impl|in_tree|index|index_of|insert|is_hole|is_neutron|is_number_conserving|is_proton|is_root|is_scalar|is_serial|is_single_reference|isospin_orbit_index|isospin_orbits|j2|ket|ket_J_offsets|ket_index|kets|label|last_used|level|lineno|lmax|local_index|local_index_table|matrix|max|max_J|max_dev|max_j2|max_two_body_J|model_space|model_space_ptr|monopole|n|name|newest_error_norm|norm|num_blocks|num_channels|num_kets|num_keys|num_orbits|num_triples|o|occupation|occupation_product_table|occupation_products|occupations|omegas|one_body|one_body_channels|orbit|orbit_class|orbits|pair_index|packed|parity|particle_hole|particles|partition|path|peek|pop_back|pop_hook|push_back|push_hook|qspace|rank|raw_line|rbegin|ref_of|reference|rend|reserve|reset|resize|rows|row_ket|row_triple|row_two_jab|s|scratch_bytes|set|size|size_bytes|solver_options|space|spec|subset_offsets|subset_table|subsets|swap|target_Z|target_mass|test|thread_level|three_body|three_body_space|total_size|tree_double|tree_find|tree_int|tree_str|tree_true|triple|triples|truncation|two_body|two_body_subsets|two_body_view|two_j|type_name|vacancy_product_table|vacancy_products|valence|value|value_or|view|where|workspace|world|zero_body)$'
  # Variables, parameters and data members: lower_case; private and protected members end in '_'.
  # Physics notation keeps its capitals (X, Y, Z, H, J, Jp, Tz, hw_MeV, twoJ; design/17
  # section 3): lower-casing would merge distinct quantities such as j and J.
  readability-identifier-naming.VariableCase: lower_case
  readability-identifier-naming.VariableIgnoredRegexp: '.*[A-Z].*'
  readability-identifier-naming.LocalVariableCase: lower_case
  readability-identifier-naming.LocalVariableIgnoredRegexp: '.*[A-Z].*'
  readability-identifier-naming.ParameterCase: lower_case
  readability-identifier-naming.ParameterIgnoredRegexp: '.*[A-Z].*'
  readability-identifier-naming.PublicMemberCase: lower_case
  readability-identifier-naming.PublicMemberIgnoredRegexp: '.*[A-Z].*'
  readability-identifier-naming.PrivateMemberCase: lower_case
  readability-identifier-naming.PrivateMemberSuffix: '_'
  readability-identifier-naming.PrivateMemberIgnoredRegexp: '.*[A-Z].*_'
  readability-identifier-naming.ProtectedMemberCase: lower_case
  readability-identifier-naming.ProtectedMemberSuffix: '_'
  readability-identifier-naming.ProtectedMemberIgnoredRegexp: '.*[A-Z].*_'
  # Constants with static storage duration and enumerators: kCamelCase. Local (automatic)
  # constants follow the variable rule; kName is accepted for them too (optional in the guide).
  readability-identifier-naming.GlobalConstantCase: CamelCase
  readability-identifier-naming.GlobalConstantPrefix: k
  readability-identifier-naming.StaticConstantCase: CamelCase
  readability-identifier-naming.StaticConstantPrefix: k
  readability-identifier-naming.ClassConstantCase: CamelCase
  readability-identifier-naming.ClassConstantPrefix: k
  readability-identifier-naming.LocalConstantCase: lower_case
  readability-identifier-naming.LocalConstantIgnoredRegexp: '(k[A-Z][A-Za-z0-9]*|.*[A-Z].*)'
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.EnumConstantPrefix: k
  # Namespaces lower_case; macros IMSRG_UPPER_CASE (header guards excepted).
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
  readability-identifier-naming.MacroDefinitionPrefix: IMSRG_
  readability-identifier-naming.MacroDefinitionIgnoredRegexp: '[A-Z0-9_]+_H_'
