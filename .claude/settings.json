{
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/tools/hooks/worktree_create.sh", "timeout": 600}
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/tools/hooks/worktree_remove.sh", "timeout": 300}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/tools/hooks/agent_guard.py", "timeout": 30}
        ]
      }
    ]
  }
}
