# imsrg-devel-d35.patch -- patch against imsrg-devel src/ (apply with `patch -p1` from the directory
# that contains src/; tools/reference/build_imsrg_devel.sh `patched` does this on a private copy).
#
# What: two quirks of imsrg++ are removed in imsrg_util.cc (D35), and three flow semantics are
# changed in IMSRGSolver.{hh,cc} and imsrg++.cc (D47, D48; hunks at the end).
#   1. TCM_Op: the two-body part no longer drops entries with |p1p2/A| <= 1e-7, so
#      Trel = T - Tcm (and thus the bare H) keeps every entry (measured effect <= 2.4e-15 MeV).
#   2. Rp2_corrected_Op (operator "Rp2"): no longer adds 1/Z * RpSpinOrbitCorrection; that term is the
#      separate operator "Rso" (already in OperatorFromString). Old Rp2 = new Rp2 + (1/Z) * Rso.
# Why: owner decision D35 (M6-Q1, M6-Q2): the rewrite fixes both quirks instead of carrying
#   compatibility switches; the e2e/hamiltonian/HF goldens are regenerated from this patched build
#   so that the integration tests keep ~1e-10 MeV agreement and identical step counts (D42: only via
#   the scripted tools/reference commands).
#   3. (D48) IMSRGSolver::Solve: after the final GatherOmega of the hunter-gatherer, H(s) :=
#      H_saved = exp(Omega_gathered) H_0 exp(-Omega_gathered), so E0 and every transformed operator
#      come from one Omega and a second stage starts from it (imsrg++ left H(s) at the last hunter
#      step, inconsistent with the gathered Omega by up to tens of keV). refharness (rh_flow.cpp)
#      repeats this line after its own final GatherOmega.
#   4. (D47) imsrg++.cc: stage 2 integrates [s1, s1 + smax] for every method (`smax += s`), instead
#      of doubling smax for Magnus only (which left flow_RK4 stage 2 empty after a stage 1 that
#      reached smax). The adaptive `flow` method keeps s = 0 (it integrates a copy of the solver),
#      so its range [0, smax] is the same length.
#   5. (D47) IMSRGSolver: SetEtaCriterion / SetODETolerance and the ODE tolerance members take
#      double instead of float (quirk P7).
# Everything else in imsrg-devel is untouched.
--- a/src/imsrg_util/imsrg_util.cc
+++ b/src/imsrg_util/imsrg_util.cc
@@ -869,10 +869,8 @@
 //            double p1p2 = Calculate_p1p2(modelspace,bra,ket,tbc.J) * hw/A;
             double p1p2 = Calculate_p1p2(modelspace,bra,ket,tbc.J) / A;
 //            std::cout << "ijkl " << bra.p << " " << bra.q << " " << ket.p << " " << ket.q << "   p1p2 = " << p1p2 << "  E2max is " << E2max << std::endl;
-            if (std::abs(p1p2)>1e-7)
-            {
-              TcmOp.TwoBody.SetTBME(ch,ibra,iket,p1p2);
-            }
+            // D35: no 1e-7 threshold; keep every two-body entry (imsrg++ drops |p1p2| <= 1e-7).
+            TcmOp.TwoBody.SetTBME(ch,ibra,iket,p1p2);
          }
       }
    }
@@ -1261,8 +1259,9 @@
  {
    if (Z==0) return 0.0*KineticEnergy_Op(modelspace);
    return R2CM_Op(modelspace) + (A-2.0)/(A*Z)*R2_1body_Op(modelspace,"proton")
-                                   - 4./(A*Z)*R2_2body_Op(modelspace,"proton")
-                                   + 1./Z * RpSpinOrbitCorrection(modelspace);
+                                   - 4./(A*Z)*R2_2body_Op(modelspace,"proton");
+   // D35: no spin-orbit correction here (imsrg++ adds + 1./Z * RpSpinOrbitCorrection(modelspace));
+   // it is the separate operator "Rso".
  }
 
  Operator Rn2_corrected_Op(ModelSpace& modelspace, int A, int Z)
--- a/src/IMSRGSolver.cc
+++ b/src/IMSRGSolver.cc
@@ -236,6 +236,9 @@
   if (hunter_gatherer)
   {
     GatherOmega();
+    // D48: H(s) becomes the rebuilt H_saved = exp(Omega) H_0 exp(-Omega) with the gathered Omega
+    // (imsrg++ leaves H(s) as the last hunter step produced it).
+    FlowingOps[0] = H_saved;
   }
 }
 
--- a/src/IMSRGSolver.hh
+++ b/src/IMSRGSolver.hh
@@ -121,8 +121,8 @@
   void SetGenerator(std::string g);
   void SetDenominatorPartitioning(std::string dp);
   void SetOmegaNormMax(double x){omega_norm_max = x;};
-  void SetODETolerance(float x){ode_e_abs=x;ode_e_rel=x;};
-  void SetEtaCriterion(float x){eta_criterion = x;};
+  void SetODETolerance(double x){ode_e_abs=x;ode_e_rel=x;};
+  void SetEtaCriterion(double x){eta_criterion = x;};
   void SetMagnusAdaptive(bool b=true){magnus_adaptive = b;};
   void SetHunterGatherer(bool b=true){hunter_gatherer = b;};
   void SetPerturbativeTriples(bool b=true){perturbative_triples = b;};
@@ -195,8 +195,8 @@
   std::vector<double> eta1;
   std::vector<double> eta2;
   std::string ode_mode;
-  float ode_e_abs;
-  float ode_e_rel;
+  double ode_e_abs;
+  double ode_e_rel;
 
 
 //  void operator()( const vector<Operator>& x, vector<Operator>& dxdt, const double t);
