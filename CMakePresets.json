{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "IMSRG_DEPS_PREFIX": "$env{IMSRG_DEPS_PREFIX}"
      }
    },
    {
      "name": "backend-openmp",
      "hidden": true,
      "cacheVariables": {
        "IMSRG_KOKKOS_BACKEND": "openmp",
        "OpenMP_ROOT": "/opt/homebrew/opt/libomp"
      }
    },
    {
      "name": "backend-serial",
      "hidden": true,
      "cacheVariables": {
        "IMSRG_KOKKOS_BACKEND": "serial"
      }
    },
    {
      "name": "debug-flags",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "-O1 -g"
      }
    },
    {
      "name": "dev-openmp",
      "displayName": "Dev (OpenMP, Debug -O1 -g)",
      "description": "Daily development: Kokkos OpenMP backend, Debug with assertions, -O1 -g",
      "inherits": [
        "base",
        "backend-openmp",
        "debug-flags"
      ]
    },
    {
      "name": "dev-serial",
      "displayName": "Dev (Serial, Debug -O1 -g)",
      "description": "Debugging: Kokkos Serial backend, Debug with assertions, -O1 -g",
      "inherits": [
        "base",
        "backend-serial",
        "debug-flags"
      ]
    },
    {
      "name": "release-openmp",
      "displayName": "Release (OpenMP, -O3 native)",
      "description": "Performance runs: Kokkos OpenMP, -O3, -mcpu=native/-march=native",
      "inherits": [
        "base",
        "backend-openmp"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "IMSRG_NATIVE_ARCH": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "AddressSanitizer + UBSan (Serial)",
      "description": "AddressSanitizer + UBSan on the Serial backend",
      "inherits": [
        "base",
        "backend-serial",
        "debug-flags"
      ],
      "cacheVariables": {
        "IMSRG_SANITIZE": "address;undefined"
      }
    },
    {
      "name": "cuda",
      "displayName": "Cluster (Kokkos CUDA, Release)",
      "description": "Cluster build, Kokkos CUDA (not testable on the dev machine). Needs Kokkos installed with CUDA in $IMSRG_DEPS_PREFIX/kokkos-cuda or -DKokkos_ROOT=...",
      "inherits": [
        "base"
      ],
      "cacheVariables": {
        "IMSRG_KOKKOS_BACKEND": "cuda",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "${sourceDir}/extern/kokkos/bin/nvcc_wrapper"
      }
    },
    {
      "name": "hip",
      "displayName": "Cluster (Kokkos HIP, Release)",
      "description": "Cluster build, Kokkos HIP (not testable on the dev machine). Needs Kokkos installed with HIP in $IMSRG_DEPS_PREFIX/kokkos-hip or -DKokkos_ROOT=...",
      "inherits": [
        "base"
      ],
      "cacheVariables": {
        "IMSRG_KOKKOS_BACKEND": "hip",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "hipcc"
      }
    },
    {
      "name": "frontier-cpu",
      "displayName": "Frontier CPU (OpenMP, Debug -O1 -g)",
      "description": "OLCF Frontier, CI preset: PrgEnv-gnu through the Cray CC wrapper (cray-mpich, cray-libsci BLAS/LAPACK), Kokkos OpenMP from $IMSRG_DEPS_PREFIX/kokkos-openmp, MPI tests via srun. Load the modules first (tools/lib/frontier_env.sh; tools/ci.sh does it).",
      "inherits": [
        "base",
        "debug-flags"
      ],
      "cacheVariables": {
        "IMSRG_KOKKOS_BACKEND": "openmp",
        "CMAKE_CXX_COMPILER": "CC",
        "IMSRG_TEST_DATA_DIR": "$env{IMSRG_WORK}/inputs",
        "IMSRG_GENERATED_GOLDEN_DIR": "$env{IMSRG_WORK}/golden-generated",
        "MPIEXEC_EXECUTABLE": "/usr/bin/srun",
        "MPIEXEC_NUMPROC_FLAG": "-n",
        "IMSRG_MPIEXEC_PREFLAGS": "--overlap --cpu-bind=none -c 4",
        "MPI_CXX_LIB_NAMES": "mpi_gnu"
      }
    },
    {
      "name": "frontier-serial",
      "displayName": "Frontier CPU (Serial, Debug -O1 -g)",
      "description": "OLCF Frontier debugging build: as frontier-cpu with the Serial Kokkos backend ($IMSRG_DEPS_PREFIX/kokkos-serial: debug checks and bounds checking); run it for kernel changes. GCC 14 reports -Wmaybe-uninitialized inside the debug Kokkos View copy (Kokkos_View.hpp, reached by inlining, so -isystem does not hide it); the warning stays visible but is not an error here (FP-Q7).",
      "inherits": [
        "base",
        "debug-flags"
      ],
      "cacheVariables": {
        "IMSRG_KOKKOS_BACKEND": "serial",
        "CMAKE_CXX_COMPILER": "CC",
        "IMSRG_TEST_DATA_DIR": "$env{IMSRG_WORK}/inputs",
        "IMSRG_GENERATED_GOLDEN_DIR": "$env{IMSRG_WORK}/golden-generated",
        "MPIEXEC_EXECUTABLE": "/usr/bin/srun",
        "MPIEXEC_NUMPROC_FLAG": "-n",
        "IMSRG_MPIEXEC_PREFLAGS": "--overlap --cpu-bind=none -c 4",
        "MPI_CXX_LIB_NAMES": "mpi_gnu",
        "CMAKE_CXX_FLAGS": "-Wno-error=maybe-uninitialized"
      }
    },
    {
      "name": "frontier-cpu-release",
      "displayName": "Frontier CPU (OpenMP, Release, ZEN3)",
      "description": "OLCF Frontier performance runs on the CPU: as frontier-cpu, Release, -march=native (ZEN3).",
      "inherits": [
        "base"
      ],
      "cacheVariables": {
        "IMSRG_KOKKOS_BACKEND": "openmp",
        "CMAKE_CXX_COMPILER": "CC",
        "CMAKE_BUILD_TYPE": "Release",
        "IMSRG_NATIVE_ARCH": "ON",
        "IMSRG_TEST_DATA_DIR": "$env{IMSRG_WORK}/inputs",
        "IMSRG_GENERATED_GOLDEN_DIR": "$env{IMSRG_WORK}/golden-generated",
        "MPIEXEC_EXECUTABLE": "/usr/bin/srun",
        "MPIEXEC_NUMPROC_FLAG": "-n",
        "IMSRG_MPIEXEC_PREFLAGS": "--overlap --cpu-bind=none -c 4",
        "MPI_CXX_LIB_NAMES": "mpi_gnu"
      }
    },
    {
      "name": "frontier-hip",
      "displayName": "Frontier GPU (Kokkos HIP gfx90a, Release)",
      "description": "OLCF Frontier MI250X: hipcc (rocm module), Kokkos HIP from $IMSRG_DEPS_PREFIX/kokkos-hip (gfx90a, ZEN3 host), cray-mpich through MPI_HOME, cray-libsci (libsci_gnu.so, named explicitly: hipcc does not link it implicitly) for host BLAS/LAPACK. Compile check for now; the Python module is off.",
      "inherits": [
        "base"
      ],
      "cacheVariables": {
        "IMSRG_KOKKOS_BACKEND": "hip",
        "CMAKE_CXX_COMPILER": "hipcc",
        "CMAKE_BUILD_TYPE": "Release",
        "IMSRG_BUILD_PYTHON": "OFF",
        "IMSRG_TEST_DATA_DIR": "$env{IMSRG_WORK}/inputs",
        "IMSRG_GENERATED_GOLDEN_DIR": "$env{IMSRG_WORK}/golden-generated",
        "MPIEXEC_EXECUTABLE": "/usr/bin/srun",
        "MPIEXEC_NUMPROC_FLAG": "-n",
        "IMSRG_MPIEXEC_PREFLAGS": "--overlap --cpu-bind=none -c 4",
        "BLAS_LIBRARIES": "$env{CRAY_LIBSCI_PREFIX_DIR}/lib/libsci_gnu.so",
        "LAPACK_LIBRARIES": "$env{CRAY_LIBSCI_PREFIX_DIR}/lib/libsci_gnu.so",
        "CMAKE_CXX_FLAGS": "--gcc-install-dir=/usr/lib64/gcc/x86_64-suse-linux/14 -ffp-contract=off"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-openmp",
      "configurePreset": "dev-openmp"
    },
    {
      "name": "dev-serial",
      "configurePreset": "dev-serial"
    },
    {
      "name": "release-openmp",
      "configurePreset": "release-openmp"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "frontier-cpu",
      "configurePreset": "frontier-cpu"
    },
    {
      "name": "frontier-cpu-release",
      "configurePreset": "frontier-cpu-release"
    },
    {
      "name": "frontier-hip",
      "configurePreset": "frontier-hip"
    },
    {
      "name": "frontier-serial",
      "configurePreset": "frontier-serial"
    }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "environment": {
        "OMP_PROC_BIND": "false",
        "OMP_NUM_THREADS": "4"
      }
    },
    {
      "name": "dev-openmp",
      "configurePreset": "dev-openmp",
      "inherits": "test-base"
    },
    {
      "name": "dev-serial",
      "configurePreset": "dev-serial",
      "inherits": "test-base"
    },
    {
      "name": "release-openmp",
      "configurePreset": "release-openmp",
      "inherits": "test-base"
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "inherits": "test-base",
      "environment": {
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    {
      "name": "frontier-cpu",
      "configurePreset": "frontier-cpu",
      "inherits": "test-base"
    },
    {
      "name": "frontier-cpu-release",
      "configurePreset": "frontier-cpu-release",
      "inherits": "test-base"
    },
    {
      "name": "frontier-serial",
      "configurePreset": "frontier-serial",
      "inherits": "test-base"
    }
  ]
}
